DATABASE_URL=postgresql://postgres:password@localhost:5432/netty_hunter
SESSION_SECRET=change_this_to_a_random_secret_string_minimum_32_chars
PORT=3001
NODE_ENV=development

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_SECURITY_MODEL=llama3.2
OLLAMA_REASONING_MODEL=deepseek-r1:7b
# Small embedding model for semantic prompt retrieval (~274MB, CPU-friendly)
# Install with: ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text

# Bug Bounty Platform API Keys (optional)
HACKERONE_API_TOKEN=
BUGCROWD_API_TOKEN=
INTIGRITI_API_TOKEN=

# External Threat Intelligence
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
