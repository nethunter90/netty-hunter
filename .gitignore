node_modules/
dist/
build/
.env
*.log
logs/
drizzle/
.DS_Store
coverage/
.nyc_output/
*.tsbuildinfo
.turbo/

# Live hunt state (runtime-generated, changes on every run)
server/context/

# Generated fine-tune dataset files (large, regenerate locally)
scripts/finetune-dataset.jsonl
scripts/hf-supplement.jsonl
scripts/bounty-scrape.jsonl

# Runtime-generated during hunts/verification — not source
server/evidence/
server/workspace/target-crashes.jsonl
server/nikto_*.json
server/workspace/audit/
server/workspace/bounty-intelligence/known-findings.json
server/workspace/bounty-intelligence/synergy/executions/
server/workspace/bounty-intelligence/synergy/playbooks/
server/workspace/bounty-intelligence/synergy/synergy-scores.json

# Nested external repo (xbow benchmarks clone, has its own .git, ~2.3GB) —
# never commit this into netty-hunter's own history
server/workspace/xbow-repo/

# ysoserial.jar (~57MB) — download via:
# curl -L -o server/tools/ysoserial.jar https://github.com/frohoff/ysoserial/releases/download/v0.0.6/ysoserial-all.jar
server/tools/*.jar

# PHP fixture deps (composer install), regenerate via `composer install --no-blocking`
server/src/fixtures/deserialization/php/vendor/

# Compiled Java fixture, regenerate via `javac Fixture.java`
server/src/fixtures/deserialization/java/*.class
